root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 120
insert_final_newline = true
ktlint_function_naming_ignore_when_annotated_with = Composable

# TerminalData.kt is generated verbatim from the decompiled AS2 source by
# scripts/gen_kotlin_data.py - regenerated, not hand-formatted, so ktlint's rules don't apply.
[**/generated/**]
ktlint = disabled

[**/data/TerminalData.kt]
ktlint = disabled
